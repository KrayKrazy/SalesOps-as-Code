EVO_INSTANCE=Número comercial

# Opcionais
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASON_MODEL=deepseek-reasoner
SDR_STATUS_SENT=contatado
SDR_STATUS_ERROR=erro
SDR_QUOTA_PER_INSTANCE=48
