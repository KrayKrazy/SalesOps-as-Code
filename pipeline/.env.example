# Intervalo aleatório entre disparos (anti-ban), em segundos (mín. 2 min)
SDR_SEND_INTERVAL_MIN=120
SDR_SEND_INTERVAL_MAX=240

# Status de "soft delete" (lead finalizado após o follow-up)
